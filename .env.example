# Bot-Token aus dem Discord Developer Portal (Bot -> Token)
DISCORD_TOKEN=
# Application ID (General Information -> Application ID)
DISCORD_CLIENT_ID=
# Optional: Server-ID. Gesetzt = Commands werden sofort nur auf diesem Server registriert.
# Leer = globale Registrierung (kann bis zu einer Stunde dauern).
DISCORD_GUILD_ID=
# Optional: Kommagetrennte Rollen-IDs, die Loot verteilen dürfen.
# Leer = jeder mit der Berechtigung "Nachrichten verwalten".
LOOT_LEADER_ROLE_IDS=
# Optional: Standard-Dauer einer Verlosung in Minuten
LOOT_DEFAULT_MINUTES=10
