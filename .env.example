# Bot-Token aus dem Discord Developer Portal (Bot -> Token)
DISCORD_TOKEN=
# ID(s) des Loot-Kanals, kommagetrennt (Rechtsklick auf Kanal -> "Kanal-ID kopieren")
LOOT_CHANNEL_IDS=
# Optional: Kommagetrennte Rollen-IDs, die Loot posten dürfen.
# Leer = jeder, der im Loot-Kanal schreiben kann.
LOOT_LEADER_ROLE_IDS=
# Optional: Anzeigename des Bots (wird beim Start gesetzt, falls abweichend)
BOT_NAME=Loot and Liberty
# Optional: Speicherort für offene Verlosungen
DATA_FILE=data/sessions.json
