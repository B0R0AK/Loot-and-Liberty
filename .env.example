# Bot token from the Discord Developer Portal (Bot -> Token)
# Bot-Token aus dem Discord Developer Portal (Bot -> Token)
DISCORD_TOKEN=

# Optional defaults – /setup (/einrichten) in Discord takes precedence.
# Optionale Vorgaben – /einrichten (/setup) in Discord hat Vorrang.

# Leader channel: leaders post screenshots/Questlog links and choose who may roll.
# Leader-Kanal: Hier posten Leader Screenshots/Questlog-Links und wählen aus, wer rollen darf.
LOOT_LEADER_CHANNEL_ID=
# Loot channel: the bot posts the item with image and a thread for the players.
# Loot-Kanal: Hierhin postet der Bot das Item mit Bild und einem Thread für die Spieler.
LOOT_CHANNEL_ID=

# Additional bot admins (user IDs, comma-separated). Server owner and administrators are always bot admins.
# Zusätzliche Bot-Admins (Nutzer-IDs, kommagetrennt). Server-Besitzer und Administratoren sind immer Bot-Admins.
BOT_ADMIN_IDS=

# Default roll time in hours / Standard-Rollzeit in Stunden
LOOT_ROLL_HOURS=24

# Default language: de or en / Standard-Sprache: de oder en
LOOT_LANGUAGE=de

# Display name of the bot / Anzeigename des Bots
BOT_NAME=Loot and Liberty
# Storage for loot rolls and settings / Speicherort für Verlosungen und Einstellungen
DATA_FILE=data/sessions.json
