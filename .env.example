# Bot-Token aus dem Discord Developer Portal (Bot -> Token)
DISCORD_TOKEN=

# Kanäle lassen sich auch im Discord mit /einrichten festlegen. Die Werte hier sind nur die Vorgabe.
# Leader-Kanal: Hier posten Leader Screenshots/Questlog-Links und wählen aus, wer rollen darf.
LOOT_LEADER_CHANNEL_ID=
# Loot-Kanal: Hierhin postet der Bot das Item mit Bild und einem Thread für die Spieler.
LOOT_CHANNEL_ID=

# Optional: zusätzliche Bot-Admins (Nutzer-IDs, kommagetrennt). Bot-Admins legen mit /leader fest,
# wer Loot-Leader ist. Server-Besitzer und Administratoren sind immer Bot-Admins.
BOT_ADMIN_IDS=

# Optional: Wie viele Stunden die Spieler Zeit zum Rollen haben (Standard 24)
LOOT_ROLL_HOURS=24

# Optional: Anzeigename des Bots (wird beim Start gesetzt, falls abweichend)
BOT_NAME=Loot and Liberty
# Optional: Speicherort für offene Verlosungen und Einstellungen
DATA_FILE=data/sessions.json
